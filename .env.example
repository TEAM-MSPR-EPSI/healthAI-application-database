# ─────────────────────────────────────────────────────────
#  MinIO — Variables d'environnement
#  Copier en .env et adapter avant de lancer docker compose
# ─────────────────────────────────────────────────────────

# Compte root MinIO (admin console)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme_strong_password_here

# Nom du site (affiché dans la console)
MINIO_SITE_NAME=social-storage

# Clés d'accès pour l'application (générées par le script d'init)
APP_ACCESS_KEY=social_app_access_key
APP_SECRET_KEY=changeme_app_secret_key_here
