{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPublicBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::avatars",
        "arn:aws:s3:::avatars/*",
        "arn:aws:s3:::covers",
        "arn:aws:s3:::covers/*",
        "arn:aws:s3:::photos",
        "arn:aws:s3:::photos/*",
        "arn:aws:s3:::videos",
        "arn:aws:s3:::videos/*",
        "arn:aws:s3:::thumbnails",
        "arn:aws:s3:::thumbnails/*",
        "arn:aws:s3:::stories",
        "arn:aws:s3:::stories/*"
      ]
    },
    {
      "Sid": "WriteAllBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::avatars/*",
        "arn:aws:s3:::covers/*",
        "arn:aws:s3:::photos/*",
        "arn:aws:s3:::videos/*",
        "arn:aws:s3:::thumbnails/*",
        "arn:aws:s3:::stories/*",
        "arn:aws:s3:::messages-media/*"
      ]
    },
    {
      "Sid": "FullAccessPrivateMedia",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::messages-media",
        "arn:aws:s3:::messages-media/*"
      ]
    },
    {
      "Sid": "GeneratePresignedUrls",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::messages-media/*"
      ]
    }
  ]
}
